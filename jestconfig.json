{
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "testPathIgnorePatterns": ["/node_modules/", "dist", "example"],
  "moduleNameMapper": {
    "\\.css$": "<rootDir>/src/__mocks__/styleMock.js"
  },
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"],
  "testEnvironment": "jsdom",
  "setupFilesAfterEach": []
}
