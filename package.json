{
  "name": "react-easy-dropzone",
  "version": "1.0.0",
  "description": "Fully customizable react dropzone component",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "yarn build:esm && yarn build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "lint": "eslint \"{**/*,*}.{js,ts,jsx,tsx}\"",
    "prettier": "prettier --write \"{src,tests,example/src}/**/*.{js,ts,jsx,tsx}\"",
    "test": "jest --config jestconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run prettier && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erlanenazarov/react-easy-dropzone.git"
  },
  "keywords": [
    "react",
    "dropzone",
    "react",
    "dropzone",
    "gallery",
    "slider",
    "image",
    "slider",
    "image",
    "uploader",
    "uploader"
  ],
  "author": "erlanenazarov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/erlanenazarov/react-easy-dropzone/issues"
  },
  "homepage": "https://github.com/erlanenazarov/react-easy-dropzone#readme",
  "devDependencies": {
    "@testing-library/react": "^13.3.0",
    "@types/jest": "^28.1.1",
    "@types/lodash.has": "^4.5.7",
    "@types/lodash.isarray": "^4.0.7",
    "@types/react": "^18.0.12",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "eslint": "^8.17.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "jest": "^28.1.1",
    "jest-canvas-mock": "^2.4.0",
    "jest-environment-jsdom": "^28.1.1",
    "node-sass": "^8.0.0",
    "prettier": "^2.6.2",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "ts-jest": "^28.0.4",
    "typescript": "^4.7.3"
  },
  "peerDependencies": {
    "react": "^18.1.0",
    "react-dom": "^18.1.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "clsx": "^1.2.1",
    "immutable": "^4.3.0",
    "lodash.has": "^4.5.2",
    "lodash.isarray": "^4.0.0"
  }
}
